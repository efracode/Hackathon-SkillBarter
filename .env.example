# PostgreSQL connection string (e.g., Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillbarter"

# Session encryption secret (minimum 32 characters)
NUXT_SESSION_PASSWORD="replace-with-a-random-32-char-secret-key"

# Google OAuth 2.0 Credentials
NUXT_OAUTH_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
NUXT_OAUTH_GOOGLE_CLIENT_SECRET="your-google-client-secret"
NUXT_OAUTH_GOOGLE_REDIRECT_URL="http://localhost:3000/api/auth/google"
